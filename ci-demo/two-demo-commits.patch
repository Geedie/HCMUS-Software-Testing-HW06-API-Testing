index 0000000..c8eae53
--- /dev/null
+++ b/.github/workflows/newman-ci.yml
@@ -0,0 +1,133 @@
+name: API Automated Tests (Newman)
+
+on:
+  push:
+    branches: [main, develop]
+  pull_request:
+    branches: [main, develop]
+
+permissions:
+  contents: read
+  checks: write        # cần cho bước "Publish test summary" (mikepenz/action-junit-report)
+  pull-requests: write # để action đó có thể comment summary lên PR
+
+jobs:
+  newman-tests:
+    runs-on: ubuntu-latest
+
+    # ĐANG DÙNG: API start trực tiếp từ source code trong repo (step "Install & start API server" bên dưới).
+    #
+    # Nếu về sau bạn đóng gói API thành Docker image thật (vd. đẩy lên Docker Hub/GHCR),
+    # có thể chuyển sang cách dùng "services" bằng cách:
+    #   1. Mở comment khối "services:" bên dưới và điền ĐÚNG tên image thật (không có dấu < >),
+    #      ví dụ: image: geedie/eshop-api:latest
+    #   2. Xoá/comment lại step "Install & start API server" ở dưới vì không cần nữa.
+    #
+    # services:
+    #   eshop-api:
+    #     image: geedie/eshop-api:latest
+    #     ports:
+    #       - 3000:3000
+
+    steps:
+      - name: Checkout repository (kèm submodule eshop-sut)
+        uses: actions/checkout@v4
+        with:
+          # QUAN TRỌNG: nếu không có dòng dưới, thư mục eshop-sut/ sẽ RỖNG trên runner
+          # (dù trên máy bạn eshop-sut/ đã có sẵn code sẵn nên không thấy vấn đề) -> npm ci ở bước sau sẽ fail ngay
+          submodules: recursive
+          # Chỉ cần dòng dưới nếu eshop-sut là repo PRIVATE (GITHUB_TOKEN mặc định không
+          # có quyền clone repo private khác). Nếu eshop-sut là repo PUBLIC, xoá dòng
+          # "token:" này đi, GITHUB_TOKEN mặc định là đủ.
+          # token: ${{ secrets.SUBMODULE_TOKEN }}
+
+      - name: Debug — kiểm tra submodule đã checkout đúng chưa
+        run: |
+          echo "--- Nội dung .gitmodules ---"
+          cat .gitmodules || echo "(KHÔNG tìm thấy file .gitmodules ở repo root)"
+          echo ""
+          echo "--- Danh sách thư mục ở repo root ---"
+          ls -la
+          echo ""
+          echo "--- git submodule status ---"
+          git submodule status || echo "(lệnh git submodule status lỗi)"
+
+      - name: Set up Node.js
+        uses: actions/setup-node@v4
+        with:
+          node-version: '20'
+
+      - name: Install Newman + reporter HTML
+        run: npm install -g newman newman-reporter-htmlextra
+
+      - name: Install & start API server
+        # eshop-sut là submodule (mono-repo có 3 frontend + 1 backend).
+        # Server thật (Express + sqlite3 + jsonwebtoken) nằm ở eshop-sut/backend,
+        # KHÔNG phải ở root của eshop-sut -> working-directory phải trỏ đúng vào đây.
+        # Dùng "npm install" thay vì "npm ci" vì backend chưa có package-lock.json
+        # committed sẵn ("npm ci" bắt buộc phải có file lock, "npm install" thì không).
+        # Nếu sau này bạn thêm package-lock.json vào eshop-sut/backend, có thể đổi lại
+        # thành "npm ci" để cài đặt nhanh & tái lập chính xác hơn.
+        working-directory: eshop-sut/backend
+        run: |
+          npm install
+          npm run start &
+          npx wait-on http://localhost:3000/api/categories --timeout 30000
+
+      - name: Run Newman test suite
+        # Collection/Environment/data.csv nằm trong thư mục con "HW06/" của repo
+        # (git ls-files xác nhận path là "HW06/New Collection.postman_collection.json"),
+        # KHÔNG phải ở repo root -> dùng working-directory để trỏ đúng vào đó.
+        # Tên file có dấu cách -> PHẢI bọc trong dấu ngoặc kép, nếu không bash sẽ
+        # hiểu nhầm "New" và "Collection.postman_collection.json" là 2 tham số khác nhau.
+        working-directory: HW06
+        run: |
+          mkdir -p newman
+          # Newman KHÔNG tự suy ra số iteration từ số dòng CSV — mặc định luôn là 1.
+          # Phải tự đếm số dòng dữ liệu (trừ header) rồi truyền vào --iteration-count,
+          # nếu không chỉ dòng đầu tiên của data.csv được chạy.
+          #
+          # FIX: dùng `wc -l` để đếm số dòng sẽ bị lệch (undercount 1 dòng) nếu file
+          # data.csv không kết thúc bằng ký tự newline ở dòng cuối — lỗi rất dễ mắc khi
+          # export CSV từ Excel/Google Sheets, và sẽ khiến TEST CASE CUỐI CÙNG bị âm
+          # thầm bỏ qua mà không có cảnh báo gì. Dùng `awk 'END{print NR}'` thay thế vì
+          # nó đếm đúng số dòng kể cả khi thiếu newline cuối file.
+          TOTAL_LINES=$(awk 'END{print NR}' data.csv)
+          ITER_COUNT=$((TOTAL_LINES - 1))
+          echo "Tổng số dòng trong data.csv (kể cả header, đếm an toàn với awk): $TOTAL_LINES"
+          echo "Số iteration sẽ chạy (số dòng data, không tính header): $ITER_COUNT"
+          newman run "New Collection.postman_collection.json" \
+            -e "New Environment.postman_environment.json" \
+            -d data.csv \
+            --iteration-count "$ITER_COUNT" \
+            --reporters cli,junit,htmlextra \
+            --reporter-junit-export newman/report.xml \
+            --reporter-htmlextra-export newman/report.html
+
+      # Newman tự thoát với exit code khác 0 nếu có bất kỳ test nào fail,
+      # nên bước trên sẽ tự làm cả job/workflow chuyển sang FAILED (❌) mà
+      # không cần thêm logic kiểm tra nào khác.
+
+      - name: Upload Newman HTML report
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: newman-html-report
+          path: HW06/newman/report.html
+
+      - name: Upload JUnit report (để hiển thị test summary trên PR)
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: newman-junit-report
+          path: HW06/newman/report.xml
+
+      - name: Publish test summary lên PR/commit
+        if: always()
+        continue-on-error: true   # nếu action này lỗi (thiếu quyền, chạy từ fork PR...),
+                                   # KHÔNG được kéo cả job thành FAILED — Newman ở step
+                                   # trên mới là nơi duy nhất quyết định pass/fail thật
+        uses: mikepenz/action-junit-report@v4
+        with:
+          report_paths: 'HW06/newman/report.xml'
+          fail_on_failure: false
